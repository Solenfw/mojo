POSTGRES_USER=your_username
POSTGRES_PASSWORD=your_password
POSTGRES_DB=your_db
DATABASE_URL=postgresql://your_username:your_password@localhost:5432/your_db
# At least 32 characters. Generate with: openssl rand -hex 32
SECRET_KEY=replace-with-output-of-openssl-rand-hex-32

# Origins allowed to call the API with credentials (JSON list).
FRONTEND_ORIGINS=["http://localhost:3000"]
# Must be true when served over HTTPS.
REFRESH_COOKIE_SECURE=false
