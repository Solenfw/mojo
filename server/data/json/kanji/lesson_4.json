{
  "lesson": "Chữ Hán Tiếng Nhật - Lesson 4",
  "grammar_points": [
    {
      "id": 1,
      "structure": "Nhóm Kanji chỉ thời gian",
      "meaning": "Các chữ Hán dùng để nói về giờ, phút, hiện tại, trước/sau và buổi sáng/buổi chiều.",
      "explanations": [
        "時 dùng để chỉ giờ hoặc thời gian; khi hỏi mấy giờ dùng 何時（なんじ）.",
        "分 dùng để chỉ phút; tùy số đứng trước mà đọc là ふん hoặc ぷん.",
        "半 nghĩa là một nửa/rưỡi, thường dùng trong cách nói giờ như 三時半.",
        "午 kết hợp với 前 và 後 tạo thành 午前（ごぜん: buổi sáng/AM）và 午後（ごご: buổi chiều/PM）.",
        "今, 前, 後 dùng để nói về bây giờ, trước và sau."
      ],
      "examples": [
        {
          "japanese": "今、何時ですか。",
          "vietnamese": "Bây giờ là mấy giờ?"
        },
        {
          "japanese": "今は 十時三十分です。",
          "vietnamese": "Bây giờ là 10 giờ 30 phút."
        },
        {
          "japanese": "会議は 十時半からです。",
          "vietnamese": "Cuộc họp bắt đầu từ 10 giờ rưỡi."
        },
        {
          "japanese": "午後に 銀行へ 行きます。",
          "vietnamese": "Tôi sẽ đi ngân hàng vào buổi chiều."
        }
      ]
    },
    {
      "id": 2,
      "structure": "Nhóm Kanji chỉ hành động",
      "meaning": "Các chữ Hán thường gặp trong động từ đi, đến và nghỉ ngơi.",
      "explanations": [
        "行 có nghĩa là đi, thường đọc là い・く khi dùng trong động từ 行きます.",
        "来 có nghĩa là đến, thường đọc là く・る khi dùng trong động từ 来ます.",
        "休 có nghĩa là nghỉ ngơi, thường đọc là やす・む hoặc xuất hiện trong từ 休み."
      ],
      "examples": [
        {
          "japanese": "明日、大学へ 行きます。",
          "vietnamese": "Ngày mai tôi đi đến trường đại học."
        },
        {
          "japanese": "友達が うちに 来ます。",
          "vietnamese": "Bạn sẽ đến nhà tôi."
        },
        {
          "japanese": "土曜日は 学校を 休んでいます。",
          "vietnamese": "Thứ Bảy tôi nghỉ học."
        }
      ]
    }
  ],
