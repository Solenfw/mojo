  text: string;
}

export interface Question {
  id: number;
  prompt: string;
  options: Option[];
}

export interface ReadingData {
  id: number;
  title: string;
  content: string;
  difficulty: string;
  questions: Question[];
  words: Record<string, { kana: string; meaning: string; level: string }>;
} 

