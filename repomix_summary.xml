  type: 'noun' | 'verb' | 'adjective' | 'adverb' | 'particle';
}

export interface Lesson {
  id: string;
  title: string;
  description: string;
  level: JLPTLevel;
  type: 'vocabulary' | 'grammar' | 'reading' | 'writing';
