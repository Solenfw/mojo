{
  "lesson": "Chữ Hán Tiếng Nhật - Số đếm",
  "grammar_points": [
    {
      "id": 1,
      "grammar": "Hàng trăm: N + 百（ひゃく）",
      "meaning": "Cách đọc các số hàng trăm trong tiếng Nhật.",
      "explanation": [
        "Thông thường, 百 được đọc là ひゃく (hyaku).",
        "Một số số khi ghép với 百 sẽ xảy ra biến âm để phát âm dễ hơn.",
        "Các trường hợp cần nhớ: 300, 600, 800."
      ],
      "examples": [
        {
          "number": "300",
          "kanji": "三百",
          "hiragana": "さんびゃく",
          "romaji": "sanbyaku",
          "note": "Biến âm thành byaku."
        },
        {
          "number": "600",
          "kanji": "六百",
          "hiragana": "ろっぴゃく",
          "romaji": "roppyaku",
          "note": "Âm ngắt + biến âm ppyaku."
        },
        {
          "number": "800",
          "kanji": "八百",
          "hiragana": "はっぴゃく",
          "romaji": "happyaku",
          "note": "Âm ngắt + biến âm ppyaku."
        }
      ]
    },
    {
      "id": 2,
      "grammar": "Hàng nghìn: N + 千（せん）",
      "meaning": "Cách đọc các số hàng nghìn trong tiếng Nhật.",
      "explanation": [
        "Thông thường, 千 được đọc là せん (sen).",
        "Một số số khi ghép với 千 sẽ xảy ra biến âm hoặc âm ngắt.",
        "Các trường hợp cần nhớ: 3000 và 8000."
      ],
      "examples": [
        {
          "number": "3,000",
          "kanji": "三千",
          "hiragana": "さんぜん",
          "romaji": "sanzen",
          "note": "Biến âm thành zen."
        },
        {
          "number": "8,000",
          "kanji": "八千",
          "hiragana": "はっせん",
          "romaji": "hassen",
          "note": "Âm ngắt thành ssen."
        }
      ]
    },
    {
      "id": 3,
      "grammar": "Hàng vạn: N + 万（まん）",
      "meaning": "Người Nhật đếm số lớn theo cụm 4 chữ số, dùng đơn vị 万 cho 10,000.",
      "explanation": [
        "Người Việt thường đếm theo cụm 3 chữ số như nghìn, triệu, tỷ.",
        "Người Nhật đếm theo cụm 4 chữ số, vì vậy 10,000 đọc là いちまん.",
        "Không đọc 10,000 là “man” đứng một mình."
      ],
      "examples": [
        {
          "number": "10,000",
          "kanji": "一万",
          "hiragana": "いちまん",
          "romaji": "ichiman",
          "vietnamese": "Một vạn / mười nghìn"
        },
        {
          "number": "20,600",
          "kanji": "二万六百",
          "hiragana": "にまんろっぴゃく",
          "romaji": "niman roppyaku",
          "vietnamese": "Hai vạn sáu trăm"
        }
      ]
    }
  ],
